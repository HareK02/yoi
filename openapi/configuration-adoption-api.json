      "RepositoryApiError": {
        "additionalProperties": false,
        "description": "Error body shared by the existing repository routes and their generated adapters.",
        "properties": {
          "diagnostics": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            },
            "type": "array"
          },
          "error": {
            "type": "string"
          },
          "failure": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StartupFailureAttachment"
              },
              {
                "type": "null"
              }
            ],
            "description": "An origin-projected error-contract attachment, not raw HTTP error text.\nReceiving it does not authorize redisclosure to a different audience."
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ],
        "type": "object"
      },
      "RuntimePolicyApplication": {
        "enum": [
          "next_current_policy_check"
        ],
        "type": "string"
      },
      "ScopedPermission": {
        "additionalProperties": false,
        "description": "Stored scopes retain their original resources and exact operation names.\n\nA legacy Worker read adapter may use [`canonical_worker_operation`] to project\noperation use, but must retain the original target separately for the Worker\nFeature's control-grant check, including direction, revocation and delegation\nlimits. Replacing an old Worker resource with WorkerOperation and discarding\nthat target would broaden authority. Neither validation nor `covers` performs\nthat conversion.",
        "properties": {
          "operation": {
            "type": "string"
          },
          "resource": {
            "$ref": "#/components/schemas/PermissionResource"
          }
        },
        "required": [
          "operation",
          "resource"
        ],
        "type": "object"
      },
      "SetContribution": {
        "additionalProperties": false,
        "properties": {
          "children": {
            "items": {
              "$ref": "#/components/schemas/PermissionReference"
            },
            "type": "array"
          },
          "set": {
            "type": "string"
          }
        },
        "required": [
          "set",
          "children"
        ],
        "type": "object"
      },
      "StartupFailureAttachment": {
        "description": "A bounded, projected envelope at the Worker/Runtime or metadata boundary.\nNo constructor accepts Display text, arbitrary JSON fields, or an unprojected error.",
        "type": "string"
      },
      "SubjectPermissions": {
        "additionalProperties": false,
        "properties": {
          "change_id": {
            "type": "string"
          },
          "delegation": {
            "items": {
              "$ref": "#/components/schemas/ScopedPermission"
            },
            "type": "array"
          },
          "execution": {
            "items": {
              "$ref": "#/components/schemas/ScopedPermission"
            },
            "type": "array"
          }
        },
        "required": [
          "change_id",
          "execution",
          "delegation"
        ],
        "type": "object"
      },
      "ToolchainContract": {
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "decodal_version": {
            "type": "string"
          },
          "entrypoints": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "fingerprint": {
            "type": "string"
          },
          "import_policy_version": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "schema_bundle": {
            "$ref": "#/components/schemas/WorkspaceConfigSchemaBundle"
          },
          "schema_version": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "contract_version",
          "decodal_version",
          "schema_version",
          "entrypoints",
          "import_policy_version",
          "schema_bundle",
          "fingerprint"
        ],
        "type": "object"
      },
      "WorkspaceConfigSchemaBundle": {
        "additionalProperties": false,
        "properties": {
          "contributions": {
            "items": {
              "$ref": "#/components/schemas/ConfigSchemaContribution"
            },
            "type": "array"
          },
          "fingerprint": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "contributions",
          "source",
          "fingerprint"
        ],
        "type": "object"
      },
      "WorkspaceConfigTreeResponse": {
        "additionalProperties": false,
        "description": "Workspace configuration tree plus the exact evaluation contract that produced it.",
        "properties": {
          "contract": {
            "$ref": "#/components/schemas/ToolchainContract"
          },
          "projection_digest": {
            "type": "string"
          },
          "snapshot": {
            "$ref": "#/components/schemas/ConfigTreeSnapshot"
          }
        },
        "required": [
          "snapshot",
          "contract",
          "projection_digest"
        ],
        "type": "object"
      },
      "string": {
        "type": "string"
      }
    },

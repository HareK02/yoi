{
  "components": {
    "schemas": {
      "ConfigCommitRequest": {
        "additionalProperties": false,
        "description": "Compare-and-swap request for applying a complete set of source-tree changes.",
        "properties": {
          "base_digest": {
            "type": "string"
          },
          "changes": {
            "items": {
              "$ref": "#/components/schemas/ConfigTreeChange"
            },
            "type": "array"
          },
          "entrypoints": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "base_digest",
          "changes",
          "entrypoints"
        ],
        "type": "object"
      },
      "ConfigContentType": {
        "description": "Source content kinds accepted by the Workspace configuration tree.",
        "enum": [
          "decodal",
          "text"
        ],
        "type": "string"
      },
      "ConfigEntry": {
        "additionalProperties": false,
        "description": "One source entry in the Workspace configuration tree.",
        "properties": {
          "content": {
            "type": "string"
          },
          "content_digest": {
            "type": "string"
          },
          "content_type": {
            "$ref": "#/components/schemas/ConfigContentType"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "content_type",
          "content",
          "content_digest"
        ],
        "type": "object"
      },
      "ConfigProjectionValidator": {
        "oneOf": [
          {
            "properties": {
              "key_aliases": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "kind": {
                "const": "static_template_catalog",
                "type": "string"
              },
              "namespace": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "namespace"
            ],
            "type": "object"
          }
        ]
      },
      "ConfigSchemaContribution": {
        "additionalProperties": false,
        "properties": {
          "authoring_source": {
            "description": "Completion-only shape for partial values; never materialized as defaults.",
            "type": [
              "string",
              "null"
            ]
          },
          "namespace": {
            "type": "string"
          },
          "projection_validator": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConfigProjectionValidator"
              },
              {
                "type": "null"
              }
            ]
          },
          "provider_id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "source_digest": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "provider_id",
          "namespace",
          "version",
          "source",
          "source_digest"
        ],
        "type": "object"
      },
      "ConfigTreeChange": {
        "description": "Base-relative change applied by a Workspace configuration commit.",
        "oneOf": [
          {
            "properties": {
              "content": {
                "type": "string"
              },
              "content_type": {
                "$ref": "#/components/schemas/ConfigContentType"
              },
              "kind": {
                "const": "create",
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "path",
              "content_type",
              "content"
            ],
            "type": "object"
          },
          {
            "properties": {
              "content": {
                "type": "string"
              },
              "expected_digest": {
                "type": "string"
              },
              "kind": {
                "const": "update",
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "path",
              "expected_digest",
              "content"
            ],
            "type": "object"
          },
          {
            "properties": {
              "expected_digest": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "kind": {
                "const": "rename",
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "from",
              "to",
              "expected_digest"
            ],
            "type": "object"
          },
          {
            "properties": {
              "expected_digest": {
                "type": "string"
              },
              "kind": {
                "const": "delete",
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "path",
              "expected_digest"
            ],
            "type": "object"
          }
        ]
      },
      "ConfigTreeSnapshot": {
        "additionalProperties": false,
        "description": "Immutable Workspace configuration tree snapshot.",
        "properties": {
          "digest": {
            "type": "string"
          },
          "entries": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ConfigEntry"
            },
            "type": "object"
          }
        },
        "required": [
          "digest",
          "entries"
        ],
        "type": "object"
      },
      "ConfigurationAdoptionReceipt": {
        "additionalProperties": false,
        "properties": {
          "history_head": {
            "type": "string"
          },
          "operation_id": {
            "type": "string"
          },
          "policy_committed": {
            "type": "boolean"
          },
          "runtime_application": {
            "$ref": "#/components/schemas/RuntimePolicyApplication"
          },
          "source_stored": {
            "type": "boolean"
          },
          "state": {
            "$ref": "#/components/schemas/WorkspaceConfigTreeResponse"
          },
          "workspace_id": {
            "type": "string"
          }
        },
        "required": [
          "workspace_id",
          "operation_id",
          "history_head",
          "state",
          "source_stored",
          "policy_committed",
          "runtime_application"
        ],
        "type": "object"
      },
      "ConfigurationAdoptionRequest": {
        "additionalProperties": false,
        "properties": {
          "expected_catalog_digest": {
            "type": "string"
          },
          "expected_head": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected_legacy_export": {
            "type": [
              "string",
              "null"
            ]
          },
          "operation_id": {
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/ConfigCommitRequest"
          }
        },
        "required": [
          "operation_id",
          "expected_catalog_digest",
          "source"
        ],
        "type": "object"
      },
      "ConfigurationMigrationDiagnostic": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "converted",
                "type": "string"
              },
              "operation": {
                "type": "string"
              },
              "subject_id": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "subject_id",
              "operation"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "domain_constraint",
                "type": "string"
              },
              "permission": {
                "$ref": "#/components/schemas/ScopedPermission"
              },
              "subject_id": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "subject_id",
              "permission"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "explicit_configuration_required",
                "type": "string"
              },
              "permission": {
                "$ref": "#/components/schemas/ScopedPermission"
              },
              "subject_id": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "subject_id",
              "permission"
            ],
            "type": "object"
          }
        ]
      },
      "ConfigurationPreviewResponse": {
        "additionalProperties": false,
        "properties": {
          "changed_paths": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "changed_subjects": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "expected_head": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "$ref": "#/components/schemas/WorkspaceConfigTreeResponse"
          }
        },
        "required": [
          "state",
          "changed_paths",
          "changed_subjects"
        ],
        "type": "object"
      },
      "ConfigurationReconciliation": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "receipt": {
                "$ref": "#/components/schemas/ConfigurationAdoptionReceipt"
              },
              "status": {
                "const": "adopted",
                "type": "string"
              }
            },
            "required": [
              "status",
              "receipt"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "export_digest": {
                "type": "string"
              },
              "status": {
                "const": "pending_transfer",
                "type": "string"
              },
              "transfer_identity": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "transfer_identity",
              "export_digest"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "No matching evidence was observed. This is not permission to change the ID.",
            "properties": {
              "status": {
                "const": "not_observed",
                "type": "string"
              }
            },
            "required": [
              "status"
            ],
            "type": "object"
          }
        ]
      },
      "ConfigurationSourceResponse": {
        "additionalProperties": false,
        "properties": {
          "catalog": {
            "$ref": "#/components/schemas/PermissionCatalog"
          },
          "catalog_digest": {
            "type": "string"
          },
          "expected_legacy_export": {
            "type": [
              "string",
              "null"
            ]
          },
          "history_head": {
            "type": [
              "string",
              "null"
            ]
          },
          "migration_diagnostics": {
            "items": {
              "$ref": "#/components/schemas/ConfigurationMigrationDiagnostic"
            },
            "type": "array"
          },
          "policies": {
            "items": {
              "$ref": "#/components/schemas/ConfigurationSubjectPolicy"
            },
            "type": "array"
          },
          "source_stored": {
            "type": "boolean"
          },
          "state": {
            "$ref": "#/components/schemas/WorkspaceConfigTreeResponse",
            "description": "Before the first adoption this is an editable, evaluated migration draft.\nsource_stored distinguishes it from the unchanged stored source."
          }
        },
        "required": [
          "state",
          "source_stored",
          "catalog",
          "catalog_digest",
          "policies",
          "migration_diagnostics"
        ],
        "type": "object"
      },
      "ConfigurationSubjectPolicy": {
        "additionalProperties": false,
        "properties": {
          "change_id": {
            "type": "string"
          },
          "delegation": {
            "$ref": "#/components/schemas/PermissionAssignment"
          },
          "execution": {
            "$ref": "#/components/schemas/PermissionAssignment"
          },
          "legacy_constraints": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SubjectPermissions"
              },
              {
                "type": "null"
              }
            ],
            "description": "Exact retained domain restrictions, not editable payloads on permission keys."
          },
          "subject_id": {
            "type": "string"
          }
        },
        "required": [
          "subject_id",
          "change_id",
          "execution",
          "delegation"
        ],
        "type": "object"
      },
      "Diagnostic": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/DiagnosticSeverity"
          }
        },
        "required": [
          "code",
          "severity",
          "message"
        ],
        "type": "object"
      },
      "DiagnosticSeverity": {
        "enum": [
          "info",
          "warning",
          "error"
        ],
        "type": "string"
      },
      "NamespaceCatalog": {
        "additionalProperties": false,
        "properties": {
          "declaration": {
            "$ref": "#/components/schemas/NamespaceDeclaration"
          },
          "enabled": {
            "type": "boolean"
          },
          "feature": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          }
        },
        "required": [
          "namespace",
          "feature",
          "enabled",
          "declaration"
        ],
        "type": "object"
      },
      "NamespaceDeclaration": {
        "additionalProperties": false,
        "description": "This input deliberately has no owner field. The Host supplies the registered\nidentity/namespace handle independently of guest-controlled declaration data.",
        "properties": {
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/PermissionDefinition"
            },
            "type": "array"
          },
          "sets": {
            "items": {
              "$ref": "#/components/schemas/SetContribution"
            },
            "type": "array"
          }
        },
        "required": [
          "permissions",
          "sets"
        ],
        "type": "object"
      },
      "NamespacePermissions": {
        "additionalProperties": false,
        "properties": {
          "keys": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "namespace": {
            "type": "string"
          }
        },
        "required": [
          "namespace",
          "keys"
        ],
        "type": "object"
      },
      "PermissionAssignment": {
        "additionalProperties": false,
        "description": "`None` at the consuming policy boundary means unset. An empty assignment is\nexplicit deny-all; this crate never chooses or reinstates a default.",
        "properties": {
          "exclusions": {
            "items": {
              "$ref": "#/components/schemas/PermissionReference"
            },
            "type": "array"
          },
          "grants": {
            "items": {
              "$ref": "#/components/schemas/PermissionReference"
            },
            "type": "array"
          },
          "revoked": {
            "type": "boolean"
          }
        },
        "required": [
          "grants",
          "exclusions",
          "revoked"
        ],
        "type": "object"
      },
      "PermissionCatalog": {
        "additionalProperties": false,
        "properties": {
          "namespaces": {
            "items": {
              "$ref": "#/components/schemas/NamespaceCatalog"
            },
            "type": "array"
          },
          "workspace": {
            "type": "string"
          }
        },
        "required": [
          "workspace",
          "namespaces"
        ],
        "type": "object"
      },
      "PermissionDefinition": {
        "additionalProperties": false,
        "properties": {
          "children": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": {
            "type": "string"
          },
          "key": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "description",
          "children"
        ],
        "type": "object"
      },
      "PermissionReference": {
        "description": "The discriminant, not an identifier's spelling, selects a reference kind.",
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "set",
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "namespace",
                "type": "string"
              },
              "value": {
                "$ref": "#/components/schemas/NamespacePermissions"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "type": "object"
          }
        ]
      },

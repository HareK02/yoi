# Editor-only shape of partial Profile values, used for completion and constraint
# analysis without materialization. Never used as defaults: omitted fields remain
# omitted until Manifest resolution.
let
    Flag = { enabled = Bool; };
    Model = {
        ref = String; scheme = String; base_url = String; model_id = String;
        auth = { kind = String; ref = String; file = String; };
        capability = Unknown; context_window = Int; max_context_window = Int;
    };
    Extraction = {
        enabled = Bool; model = Model; reasoning = String;
        threshold = Int; worker_max_turns = Int;
    };
    Scope = { intent = String; deny_write = [...String]; symlink_policy = String; };
    Profile = {
        slug = String;
        description = String;
        worker = { mode = String; };
        model = Model;
        engine = {
            instruction = String; language = String; reasoning = Unknown;
            max_tokens = Int; max_turns = Int; temperature = Unknown; top_p = Unknown;
            top_k = Int; stop_sequences = [...String]; tool_call_dispatch = String;
            tool_output = { default_max_bytes = Int; per_tool = { ...Int }; };
            file_upload = { max_bytes = Int; };
        };
        scope = Scope;
        delegation_scope = Scope;
        session = {
            record_event_trace = Bool;
        };
        permissions = { default_action = String; rule = [...{ tool = String; pattern = String; action = String; }]; };
        feature = {
            task = Flag; web = Flag; image = Flag; sub_worker = Flag; flow = Flag;
            worker = { enabled = Bool; direct_spawn = Bool; };
            workspace_worker_discovery = Flag; objective = Flag; manage_workdir = Flag;
            workdir_catalog = Flag; workspace_config = Flag; orchestration = Flag;
            ticket = { enabled = Bool; authoring = Bool; thread = Bool; intake = Bool; workflow = Bool; };
            merge_request = { show = Bool; open = Bool; review = Bool; readiness_check = Bool; complete = Bool; };
            memory = {
                enabled = Bool; staging_tools = Bool;
                resident = { inject_summary = Bool; };
                extraction = Extraction;
                consolidation = { request_enabled = Bool; };
            };
            subjektiv = { enabled = Bool; consolidation_tools = Bool; extraction = Extraction; };
        };
        mcp = { stdio_server = [...{
            name = String; command = String; args = [...String];
            cwd = { kind = String; path = String; };
            env = { inherit = [...String]; set = { ...Unknown }; };
        }]; };
        compaction = {
            kind = String; threshold = Unknown; request_threshold = Unknown;
            prune_enabled = Bool; worker_context_max_tokens = Unknown;
            worker_max_turns = Int; model = Model;
        };
        web = {
            enabled = Bool; allow_private_addresses = Bool;
            search = { enabled = Bool; provider = String; api_key_secret = String; timeout_secs = Int; base_url = String; country = String; search_lang = String; ui_lang = String; safesearch = String; };
            fetch = { enabled = Bool; timeout_secs = Int; redirect_limit = Int; max_response_bytes = Int; max_output_bytes = Int; allow_private_addresses = Bool; };
        };
        skills = { directories = [...String]; };
    };
in {
    profile = {
        default_profile = String;
        entries = [...{
            selector = String; profile = Profile; label = String; description = String;
        }];
    };
}

# Optional MR implementation/integration recipe, not a universal Ticket pipeline.
# Backend MR records, not this Session-local graph, own phases and publication.
{
    schema_version = 1;
    name = "coder-review";
    initial = "observe";

    states = {
        observe = {
            instructions = "This is an optional code recipe for requested Git publication and independent review, not a universal Ticket gate. Honor bounded return, no-review, no-commit and no-push instructions and existing grants. Read current Ticket requirements, discussion, delegation and the explicitly addressed MR with ShowMergeRequest before choosing work. Inspect the bound Workdir Git state. For an existing MR read its saved phase, worker_assignment, source, review, summary.readiness and completion/failure evidence; reuse its selectors. MR worker ownership is separate from the Ticket implementation assignment. A different authorized Coder may continue the MR without replacing that Ticket assignment or requiring the original Session. Confirm current MR ownership and resource grants before mutations; a phase or Flow never grants authority. For new work only, prepare implementation; for an existing Integration MR continue integration; for Completed report saved evidence; for Canceled report cancellation. Do not repeat implementation or review just because this Session is new. Source/requirement changes need fresh review, but worker succession or target-only movement do not invalidate unchanged-source approval. No persisted order, integration-request object or Subject stamp is needed. On missing authority or a required scope/target decision, record the bounded blocker and return without polling. Catalog changes do not replace a pinned Session Flow. Active Flow replacement is rejected; continue its pinned contract or use an explicitly authorized new Worker. Explicit Flow entry after a terminal instance resolves the current catalog; never pretend restored old instructions changed.";
            transitions = {
                implement = { target = "implement"; condition = "Current requirements and grants allow implementation, and there is no MR yet or the addressed MR is in Implementation. Current Workdir and assignment evidence have been inspected."; };
                integrate = { target = "integrate"; condition = "The addressed MR is in Integration, and its current worker, source, review and publication observations have been read. This is continuation, not a new Ticket implementation assignment."; };
                complete = { target = "complete"; condition = "The addressed MR is Completed with saved publication/completion evidence for its exact approved source and target."; };
                canceled = { target = "canceled"; condition = "The addressed MR is Canceled; no new publication or implementation is authorized by this recipe."; };
            };
        };

        implement = {
            instructions = "Reread current requirements and any existing MR before work, including after new input. If its phase or authority changed, return to observe instead of following stale instructions. Reuse a suitable work branch, or create a collision-safe work branch from the requested base; never overwrite a branch or discard pre-existing changes. Implement the requested scope and resolve existing review findings. Run affected validation and record concrete evidence in coherent commits. Publish only the MR source work branch with a normal non-force push under existing grants; verify the provider resolves selector_from to exact committed HEAD. Open one MR with OpenMergeRequest if none exists; otherwise keep the existing MR and selectors. Do not invent a source-candidate operation or replacement MR. Do not manually push the target, tags or unrelated refs, force-push or delete branches. Do not request review from a dirty Workdir or unpublished source. If a valid review or active Reviewer already exists for the exact current source and requirements, reuse that fact rather than starting a duplicate review. Keep review/fix evidence on the MR with CommentMergeRequest. A Flow transition cannot advance the Backend MR phase or conclude the Ticket.";
            transitions = {
                review = { target = "review"; condition = "Implementation is committed, clean and validated; the provider resolves the existing MR source ref to exact HEAD, and independent review is needed or a current Reviewer attempt must be continued. The MR is still in Implementation."; };
                changed = { target = "observe"; condition = "A fresh MR/authority observation supersedes implementation: the MR has left Implementation or authority/requirements now require reassessment. Do not mutate using stale Session state."; };
            };
        };

        review = {
            instructions = "Read the addressed MR and requirements again. If exact-source approval already remains valid, do not request another review merely for target movement or worker succession. Otherwise verify clean committed and published source, then spawn one actual direct-child builtin:reviewer with needed writable scope, explicit command grant, and structured Ticket/MR review binding under current authority. Continue an existing active exact-source attempt rather than spawning duplicates. The trusted spawn layer records ReviewRequested and injects capability; do not put capability material, commit/ref identity or a prewritten verdict into model input. The Reviewer must submit ReviewMergeRequest; prose and lifecycle notifications are not verdicts. Inspect committed child evidence and reread the current MR after notification before adopting the result. Yield while the child runs; do not poll. Approval can already trigger Backend publication and completion before the next Flow transition. On changed requirements, cancellation or lost authority, return to observe. No Subject response, second approval of unchanged source or model push decision is required.";
            transitions = {
                approved = { target = "integrate"; condition = "The current authoritative MR has valid independent approval for its exact source, current requirements and complete linked result snapshot, no unresolved request_changes, and is Integration or already Completed. Use saved Backend phase, not a Flow-inferred phase."; };
                changes_requested = { target = "fix"; condition = "The active MR has current unresolved request_changes findings for the candidate; current authority permits addressing them."; };
                changed = { target = "observe"; condition = "The MR is Canceled, source/requirements changed during review, or current authority prevents continuation. Neither the approved nor changes_requested condition applies."; };
            };
        };

        fix = {
            instructions = "Reread the MR, current requirements and findings before editing. Resolve current findings on the existing MR source branch. In Integration, merge the latest target into that source and resolve conflicts as needed within the requested scope; do not create an MR aggregation or demand a new integration branch. Choose the merge/resolution and validation methods; the independent Reviewer evaluates the resulting complete candidate. Cite reusable evidence for unaffected scope under equivalent conditions, distinguishing it from checks actually rerun. Assess dependencies, features, generated code, shared initialization, migrations and environment. Commit fixes and publish the same source ref with a normal non-force push; verify provider ref equals clean HEAD before fresh review. Do not rewrite reviewed history, reuse an old verdict for changed source, or discard pre-existing work. Manual target push belongs only to the explicit recovery path after valid review, not this fix step. Record resolution evidence with CommentMergeRequest. If scope, adopted changes or target must change, return the decision to the Subject rather than silently changing selectors. Reread on new input; lost authority or changed MR phase requires observation, not continued editing.";
            transitions = {
                review = { target = "review"; condition = "Current findings are addressed with affected validation, corrected source is committed and clean, provider source equals HEAD, and the active MR requires a fresh independent verdict under current grants."; };
                changed = { target = "observe"; condition = "Cancellation, completion, missing authority or changed requirements/scope prevent the current fix cycle; review readiness has not been established."; };
            };
        };

        integrate = {
            instructions = "Call ShowMergeRequest and read the saved phase, current worker, source, review, summary.readiness and completion/failure evidence before acting and after each new input. If already Completed, use that evidence without another review or push. For an active Integration MR, incorporate latest target into this MR source when needed, resolve conflicts, validate and commit within the requested scope. Merge technique and test selection belong to the Coder, evaluated by the independent Reviewer; no Subject technical stamp or saved order is required. Keep the same MR/source selectors. Prepare independent MRs or delegated conflict work in separate writable scopes in parallel; protect actual shared Workdir/resources, not all work sharing a target. Record conflict, decision request and resolution evidence with CommentMergeRequest. Return scope/target/adopted-change decisions to the Subject. Changed source or requirements require fresh independent review after clean source publication and provider verification. Unchanged approved source that can still fast-forward needs no second approval. Backend automatically uses the Coder Workdir to publish the fixed approved source by normal fast-forward push and records completion; automatic success needs no extra Tool or Subject approval. Failure, pre-publication blockers or unconfirmed outcomes are recorded as MR comments and notified to the Subject; no automatic retry/reconciliation loop is scheduled. Return the next-action decision to the Subject. On explicit recovery direction and current grants, inspect the remote, resolve the cause with ordinary Git and manually non-force push the approved source to the MR target if needed, then call CompleteMergeRequest. Complete only verifies and records publication; it never pushes. Reuse unchanged-source/requirements approval, but obtain independent review if source/requirements change. Do not race an in-flight attempt, infer failure from silence or blindly repush an uncertain result. If no useful authorized work remains, record only a material blocker/handoff if needed and end the turn without polling or terminal-success transition; remain resumable on notification or explicit input. A read or Flow transition does not trigger publication or grant authority.";
            transitions = {
                review = { target = "review"; condition = "The active Integration MR needs a fresh verdict for changed/unapproved source or requirements; the complete candidate is validated, committed and clean, provider source equals HEAD, and no publication is in flight. A valid unchanged-source approval does not satisfy this condition."; };
                completed = { target = "complete"; condition = "ShowMergeRequest reports Completed with saved confirmed publication/completion evidence bound to the approved source and requested target; approval alone or Flow state is insufficient."; };
                canceled = { target = "canceled"; condition = "A fresh ShowMergeRequest reports Canceled; any already-sent publication facts remain distinct from cancellation and must not be described as unconditional completion."; };
            };
        };

        complete = {
            instructions = "Reread ShowMergeRequest and confirm saved Completed/publication evidence before reporting integration. Save concise result and validation references with TicketImplementationResult, including retained MR/source evidence; do not duplicate every review iteration on the Ticket. The Host owns report transport retry identity; reconcile uncertain receipts before a new invocation. Do not supply assignment identities or model actor claims. This factual result is not the Subject's handling judgment, Ticket closure, work release or Worker stop. Completion rests on Backend evidence, not this Flow, and does not require a Subject stamp. If the current evidence no longer supports completion, return to observe rather than claiming success.";
            transitions = {
                completed = { target = "done"; condition = "Confirmed MR publication/completion evidence and the bounded result have been durably reported. Ticket conclusion and Subject handling remain separate."; };
                changed = { target = "observe"; condition = "Current MR evidence does not support the completion report; reassessment is required rather than success."; };
            };
        };

        canceled = {
            instructions = "The MR is Canceled, not successfully completed. Report the observed cancellation and any distinct saved publication facts without starting a new push or erasing history. Ticket judgment, handling, resource release and Worker lifecycle remain separate. New work requires current intent and authority, not this terminal Flow.";
            terminal = true;
        };
        done = {
            instructions = "Confirmed MR completion and bounded result evidence were reported. Do not infer Ticket closure, Subject handling done, unassignment, resource release or Worker stop. A retained receipt and this terminal Flow do not authorize new work. Use current intent, MR evidence and permissions on later input.";
            terminal = true;
        };
    };
}

{
    slug = "async-chat";
    description = "Connected Subject conversation and assigned Ticket coordination through bounded background Workers; operations require current policy and domain authority.";
    # Omitted scope and delegation_scope resolve to no filesystem authority.
    model = { ref = "codex-oauth/gpt-6.1-sol"; };
    engine = { instruction = "role.async_chat"; reasoning = "high"; };
    session = { record_event_trace = true; };

    feature = {
        filesystem = { enabled = false; };
        filesystem_write = { enabled = false; };
        bash = { enabled = false; };
        drive = { enabled = false; };
        task = { enabled = false; };
        memory = { enabled = false; staging_tools = false; };
        subjektiv = {
            enabled = true;
            chat = { enabled = true; };
            consolidation_tools = false;
            extraction = { enabled = true; threshold = 50000; };
        };
        web = { enabled = false; };
        image = { enabled = false; };
        sub_worker = { enabled = false; };
        flow = { enabled = false; };
        worker = { enabled = true; direct_spawn = true; };
        workspace_worker_discovery = { enabled = true; };
        objective = { enabled = true; };
        manage_workdir = { enabled = true; };
        workdir_catalog = { enabled = false; };
        workspace_config = { enabled = false; };
        ticket = { enabled = true; authoring = true; thread = true; intake = false; workflow = true; };
        merge_request = { show = true; open = false; review = false; readiness_check = true; complete = true; };
        orchestration = { enabled = true; };
    };
    web = { enabled = false; };

}

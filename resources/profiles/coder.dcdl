import "./base.dcdl" // {
    slug = "coder";
    description = "Ticket implementation coder profile.";
    scope = "workspace_write";
    model = { ref = "codex-oauth/gpt-6.1-sol"; };
    engine = {
        instruction = "role.coder";
        reasoning = "high";
    };

    feature = {
        drive = { enabled = true; };
        task = { enabled = true; };
        memory = { enabled = false; };
        subjektiv = { enabled = true; };
        web = { enabled = true; };
        sub_worker = { enabled = true; };
        flow = { enabled = true; };
        ticket = { enabled = true; thread = true; };
        merge_request = {
            show = true;
            open = true;
            review = false;
            readiness_check = false;
            complete = false;
        };
    };
}

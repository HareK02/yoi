import "./base.dcdl" // {
    slug = "companion";
    description = "Workspace companion profile.";
    scope = "workspace_write";
    model = { ref = "codex-oauth/gpt-6-astra"; };

    feature = {
        drive = { enabled = true; };
        task = { enabled = true; };
        subjektiv = { enabled = true; };
        web = { enabled = true; };
        sub_worker = { enabled = true; };
        worker = { enabled = true; direct_spawn = false; };
        workspace_worker_discovery = { enabled = true; };
        manage_workdir = { enabled = true; };
        merge_request = { query = true; show = true; worker_set = true; comment = true; };
        ticket = { enabled = true; authoring = true; thread = true; };
    };
}

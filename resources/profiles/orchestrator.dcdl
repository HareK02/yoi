import "./base.dcdl" // {
    slug = "orchestrator";
    description = "Intent-led Ticket orchestration with separate guarded MR integration authority.";
    scope = "workspace_write";
    engine = { instruction = "role.orchestrator"; };

    feature = {
        drive = { enabled = true; };
        task = { enabled = true; };
        memory = { enabled = false; };
        subjektiv = { enabled = true; };
        web = { enabled = true; };
        sub_worker = { enabled = false; };
        worker = { enabled = true; direct_spawn = false; };
        manage_workdir = { enabled = true; };
        ticket = { enabled = true; thread = true; workflow = true; };
        merge_request = {
            show = true;
            open = false;
            review = false;
            readiness_check = true;
            complete = true;
        };
        orchestration = { enabled = true; };
    };
}

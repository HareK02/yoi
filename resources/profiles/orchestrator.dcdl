import "./base.dcdl" // {
    slug = "orchestrator";
    # 互換slugを維持するが、Subject担当・本体所有・操作権限はこのProfileから付与しない。
    description = "Ticket outcome coordination for an assigned Subject, with candidate selection, validation and bounded delegation; no fixed assignee or privileged role identity. MR workflows are optional.";
    scope = "workspace_write";
    engine = { instruction = "role.orchestrator"; };

    feature = {
        drive = { enabled = true; };
        task = { enabled = true; };
        memory = { enabled = false; };
        subjektiv = { enabled = true; };
        web = { enabled = true; };
        sub_worker = { enabled = true; };
        worker = { enabled = true; direct_spawn = false; };
        manage_workdir = { enabled = true; };
        ticket = { enabled = true; thread = true; workflow = true; };
        merge_request = {
            show = true;
            open = false;
            review = false;
            readiness_check = true;
            complete = true;
        };
        orchestration = { enabled = true; };
    };
}

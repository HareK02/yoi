{
  "schemaVersion": 1,
  "id": "console-live-baseline-dark",
  "title": "Production Console Feature invocation draft lifecycle",
  "baseUrl": "http://127.0.0.1:15286",
  "colorScheme": "dark",
  "reducedMotion": "reduce",
  "personas": [
    {
      "id": "fixture",
      "label": "Live synthetic Worker",
      "auth": {
        "kind": "anonymous"
      }
    }
  ],
  "viewports": [
    {
      "label": "desktop",
      "width": 1440,
      "height": 900
    },
    {
      "label": "narrow",
      "width": 768,
      "height": 900
    },
    {
      "label": "mobile",
      "width": 390,
      "height": 844
    }
  ],
  "routes": [
    {
      "id": "console",
      "label": "Live Console",
      "path": "/w/console-live-review/workers/W-901-console-live-fixture/console",
      "goal": "Inspect the unchanged production Console shell and literal slash text before Feature completion existed.",
      "dataState": "Live synthetic idle Worker; review enum/integer/boolean/worker-file arguments plus generic attachment adapter. No real account, file, or invocation execution.",
      "ready": {
        "kind": "selector",
        "selector": ".cm-content[contenteditable=true]"
      },
      "capturePoints": [
        {
          "id": "initial",
          "label": "Idle live Console"
        },
        {
          "id": "slash-plain",
          "label": "Literal unselected slash text",
          "interaction": [
            {
              "action": "click",
              "selector": ".cm-content"
            },
            {
              "action": "press",
              "selector": ".cm-content",
              "key": "Control+a"
            },
            {
              "action": "press",
              "selector": ".cm-content",
              "key": "Backspace"
            },
            {
              "action": "press",
              "selector": ".cm-content",
              "key": "/"
            },
            {
              "action": "press",
              "selector": ".cm-content",
              "key": "r"
            },
            {
              "action": "press",
              "selector": ".cm-content",
              "key": "e"
            },
            {
              "action": "press",
              "selector": ".cm-content",
              "key": "v"
            },
            {
              "action": "press",
              "selector": ".cm-content",
              "key": "i"
            },
            {
              "action": "press",
              "selector": ".cm-content",
              "key": "e"
            },
            {
              "action": "press",
              "selector": ".cm-content",
              "key": "w"
            },
            {
              "action": "press",
              "selector": ".cm-content",
              "key": "("
            },
            {
              "action": "press",
              "selector": ".cm-content",
              "key": "b"
            },
            {
              "action": "press",
              "selector": ".cm-content",
              "key": "r"
            },
            {
              "action": "press",
              "selector": ".cm-content",
              "key": "i"
            },
            {
              "action": "press",
              "selector": ".cm-content",
              "key": "e"
            },
            {
              "action": "press",
              "selector": ".cm-content",
              "key": "f"
            },
            {
              "action": "press",
              "selector": ".cm-content",
              "key": ")"
            },
            {
              "action": "press",
              "selector": ".cm-content",
              "key": "Escape"
            }
          ],
          "ready": {
            "kind": "selector",
            "selector": ".cm-content[contenteditable=true]"
          }
        }
      ]
    }
  ],
  "processes": [
    {
      "id": "console-live-fixture",
      "command": "deno",
      "cwd": "..",
      "args": [
        "run",
        "--allow-net",
        "--allow-read",
        "--allow-env=WEB_UX_BUILD_ROOT",
        "browser-tests/console_live_fixture_server.ts",
        "15286"
      ],
      "env": {
        "WEB_UX_BUILD_ROOT": "${WEB_UX_BUILD_ROOT}"
      },
      "readyUrl": "http://127.0.0.1:15286/health"
    }
  ]
}

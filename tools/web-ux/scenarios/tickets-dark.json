  "processes": [
    {
      "id": "ticket-fixture",
      "command": "deno",
      "cwd": "..",
      "args": [
        "run",
        "--allow-net",
        "--allow-read",
        "browser-tests/ticket_fixture_server.ts",
        "15289",
        "../../web/workspace/build"
      ],
      "readyUrl": "http://127.0.0.1:15289/health"
    }
  ]
